FROM node:20-alpine

WORKDIR /app

# Copy server package definitions
COPY server/package*.json ./

RUN npm ci --only=production

# Copy server source code
COPY server/ ./

# Expose Node.js Express Gateway port
EXPOSE 5000

ENV PORT=5000
ENV MONGODB_URI=mongodb://mongodb:27017/roadvision
ENV PYTHON_BACKEND_URL=http://backend:8000

CMD ["node", "src/index.js"]

