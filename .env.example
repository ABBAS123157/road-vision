# RoadVision AI - Environment Configuration Example

PROJECT_NAME="RoadVision AI"
DATABASE_URL="sqlite:///./roadvision.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://user:password@localhost:5432/roadvision_db"

SECRET_KEY="replace-with-a-random-super-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Speed Guidance Default Limits (km/h)
DEFAULT_SPEED_LIMIT_CITY=50
DEFAULT_SPEED_LIMIT_HIGHWAY=80
DEFAULT_SPEED_LIMIT_RESIDENTIAL=30
DEFAULT_SPEED_LIMIT_RURAL=60

# Advance Hazard Alert Range Thresholds (meters)
HAZARD_ALERT_1KM=1000
HAZARD_ALERT_500M=500
HAZARD_ALERT_200M=200

